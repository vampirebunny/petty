{
  "expo": {
    "name": "Boop Boop",
    "slug": "boop-boop",
    "version": "1.0.0",
    "scheme": "boopboop",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "appleTeamId": "89T43H6V58",
      "bundleIdentifier": "app.mylisto.boop",
      "associatedDomains": ["applinks:boopboop.mylisto.app"],
      "entitlements": {
        "com.apple.developer.declared-age-range": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "boopboop",
              "com.googleusercontent.apps.258906929083-hubgfqmc81rnc09ut0kv3ov183rbp62q"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.mylisto.boop",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "boopboop.mylisto.app",
              "pathPrefix": "/get"
            },
            {
              "scheme": "https",
              "host": "boopboop.mylisto.app",
              "pathPrefix": "/add/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAAB45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAAB45",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-screen-orientation",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "./modules/age-signals/app.plugin.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidR8Optimize.js",
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.258906929083-hubgfqmc81rnc09ut0kv3ov183rbp62q"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#FAAB45"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Boop Boop uses the camera to scan friends' codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/withPhonePortrait.js"
    ],
    "extra": {
      "eas": {
        "projectId": "2b7285d6-d03f-453f-96bc-01c556649375"
      }
    }
  }
}
